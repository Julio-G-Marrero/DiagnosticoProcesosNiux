@page "/monitor"
@using ExistenciasReset.Models

<PageTitle>Monitor de Sistemas</PageTitle>

<div class="container" style="max-width: 1100px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <p class="text-muted mb-0">
            Panorama de las @Summaries.Count sistema(s): conexiones activas y la consulta/procedimiento más lento corriendo ahora mismo en cada uno.
        </p>
        <button class="btn btn-sm btn-outline-secondary" disabled="@IsLoading" @onclick="LoadAsync">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar todo
        </button>
    </div>

    @if (IsLoading && Summaries.Count == 0)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Sistema</th>
                        <th>Estado</th>
                        <th>Conexiones</th>
                        <th>Consultas activas</th>
                        <th>Más lenta corriendo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in Summaries.OrderByDescending(s => s.LongestRunningSeconds))
                    {
                        <tr class="@RowClass(summary)">
                            <td>@summary.TenantName (@summary.TenantId)</td>
                            <td>
                                @if (!summary.Reachable)
                                {
                                    <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>Sin conexión</span>
                                }
                                else if (summary.LongestRunningSeconds > 300)
                                {
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Lento</span>
                                }
                                else if (summary.LongestRunningSeconds > 60)
                                {
                                    <span class="text-warning"><i class="bi bi-exclamation-circle-fill me-1"></i>Ocupado</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>OK</span>
                                }
                            </td>
                            <td>@summary.AttachmentCount</td>
                            <td>@summary.ActiveStatementCount</td>
                            <td>
                                @if (summary.LongestRunningSeconds > 0)
                                {
                                    <span>@summary.LongestRunningSeconds s — @summary.LongestRunningDescription</span>
                                }
                                else if (!summary.Reachable)
                                {
                                    <span class="text-muted small">@summary.ErrorMessage</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="@($"/?tenant={summary.TenantId}")">Ver detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
